# Maintainer: Galin Georgiev
pkgname=personal-spotify
pkgver=0.1.0
pkgrel=1
pkgdesc="Lightweight native Spotify client (Gio, embedded go-librespot)"
arch=('x86_64')
url="https://github.com/GGGeorgiev20/personal-spotify"
license=('GPL-3.0-only')
depends=('wayland' 'libxkbcommon' 'libglvnd' 'alsa-lib' 'libogg' 'libvorbis' 'flac' 'mpg123' 'glibc')
makedepends=('go' 'git')
optdepends=('ffmpeg: Canvas videos in the Now Playing view'
            'noto-fonts-emoji: color emoji'
            'org.freedesktop.secrets: keyring for the login (GNOME Keyring or KWallet)')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')
options=('!debug' '!lto')

build() {
  cd "$pkgname-$pkgver"
  make build
}

package() {
  cd "$pkgname-$pkgver"
  make install DESTDIR="$pkgdir" PREFIX=/usr
}
